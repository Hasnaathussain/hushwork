# Required for production-like sessions. Use a unique random value per environment.
AUTH_SECRET=replace-with-a-32-character-random-string

# Dedicated hosted Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: enables model-backed responses in the shopping assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public origin used for canonical links and payment redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origins allowed to call the bearer-token mobile API in development/production.
MOBILE_APP_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: enables Stripe-hosted checkout. The app fails closed when absent.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
